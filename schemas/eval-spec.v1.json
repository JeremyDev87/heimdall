{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heimdall:eval-spec:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "policy",
    "isolation",
    "command",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "isolation": {
      "const": "trusted-local"
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argv",
        "timeout_seconds"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "env": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "kind": {
            "enum": [
              "file_exists",
              "file_equals",
              "path_absent"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "expected": {
            "type": "string",
            "maxLength": 65536
          }
        }
      }
    }
  }
}
