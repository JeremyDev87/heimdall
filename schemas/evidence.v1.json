{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heimdall:evidence:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "policy",
    "isolation",
    "execution",
    "boundary",
    "checks",
    "semantic_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest_before",
        "digest_after",
        "no_write"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "digest_before": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "digest_after": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "no_write": {
          "type": "boolean"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "effective",
        "security_boundary"
      ],
      "properties": {
        "requested": {
          "const": "trusted-local"
        },
        "effective": {
          "const": "temp-copy-sanitized-env"
        },
        "security_boundary": {
          "const": false
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_digest",
        "exit_code",
        "timed_out",
        "launch_error",
        "stdout",
        "stderr"
      ],
      "properties": {
        "command_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        },
        "launch_error": {
          "type": "boolean"
        },
        "stdout": {
          "$ref": "#/$defs/blob"
        },
        "stderr": {
          "$ref": "#/$defs/blob"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outside_workspace_write"
      ],
      "properties": {
        "outside_workspace_write": {
          "type": "boolean"
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "status",
          "artifact_digest"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file_exists",
              "file_equals",
              "path_absent"
            ]
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "MISSING"
            ]
          },
          "artifact_digest": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "semantic_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "size"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
